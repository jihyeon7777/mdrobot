<?xml version="1.0"?>
<!--
  The machine, as RViz sees it.

  CAD frame vs ROS frame
  ======================
  The meshes come out of the assembly in the CAD's own frame, which is not
  REP-103. Worked out from the files themselves rather than assumed:

    * the wheel's two non-axle extents match to 0.000%, so its axle is along
      CAD z — which makes CAD z the machine's left-right axis;
    * of the two axes left, CAD y must be up: the wheel's lowest point sits at
      y 9.787 and the body's at 20.439, so the wheels stick out below the body.
      Read the other way round the chassis would be dragging on the floor.

  CAD y is up, then. Which of the other two is fore-aft could NOT be read off
  the files: the base is nearly square (512 by 610) and both candidates put a
  wheel in a sensible place. Driving it settled it. With CAD x taken as
  forward the model crabbed sideways across RViz while the machine drove
  straight, so CAD z is fore-aft and CAD x is left-right.

  Which leaves the wheel contradicting itself: its axle is along CAD z, and CAD
  z is now fore-aft, and no wheel has a fore-aft axle. So the wheel was
  exported in PART orientation with only its assembly TRANSLATION applied —
  the file puts it in the right place and the wrong attitude. mesh_check
  cannot see that, because an offset origin looks the same either way.

  Hence two yaws rather than one. Every mesh is first rotated +90 deg about X
  to stand CAD y up, then about Z by its own angle: the body by 90 deg to put
  its fore-aft on ROS x, the wheel by 0 so its axle stays on ROS y. Both are
  arguments, because a further 180 deg is not observable from the geometry —
  if the machine drives backwards in RViz, add 180 to body_yaw_deg.

  The parts were exported in ASSEMBLY coordinates, so each mesh also carries a
  translation that brings its own origin to where the link is. Without it a
  wheel does not spin when its joint turns, it orbits on a lever arm as long as
  its offset. mesh_check reports those offsets:

    body  bbox centre (256.714, 115.174, 305.300) mm, wheels touch at y 9.787
    wheel bbox centre ( 74.291,  74.230, 107.614) mm

  Which numbers are true
  ======================
  Wheel radius, track and wheelbase are ARGUMENTS, not constants, because the
  CAD and supervisor.yaml disagree and the disagreement is not settled:

                 supervisor.yaml    measured off the CAD
    wheel_radius     0.0625 m           0.0644 m
    wheelbase        0.500 m            0.395 m
    track            0.575 m            0.365 m

  (The CAD wheelbase and track swapped over when driving showed CAD z to be
  the fore-aft axis. The pair is nearly square, which is exactly why the files
  could not settle it alone.)

  The radius gap is expected — 0.0625 is the EFFECTIVE rolling radius, checked
  by driving a commanded 1.000 m, and a loaded tyre rolls smaller than it
  measures. The other two are not explainable that way, and they matter: the
  kinematics uses lxy = (wheelbase + track) / 2 as the yaw lever arm, so if the
  CAD is right the machine has been yawing about 40% faster than commanded. The
  1 m test could never have caught it, because straight-line distance does not
  contain track or wheelbase at all.

  Defaults follow supervisor.yaml so the picture shows what the machine
  BELIEVES. Pass the CAD numbers to see whether they fit the body better:

    ros2 launch mdrobot_description display.launch.py \
        wheelbase:=0.365 track:=0.395

  The CAD-derived track and wheelbase assume the assembly's bounding box is
  centred on the wheel pattern. A tape measure across the wheel centres settles
  it in a way neither the CAD nor this file can.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mdrobot">

  <!-- Kinematic geometry. Defaults match mdrobot_supervisor/config/supervisor.yaml. -->
  <xacro:arg name="wheel_radius" default="0.0625"/>
  <xacro:arg name="track" default="0.575"/>
  <xacro:arg name="wheelbase" default="0.5"/>

  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="track" value="$(arg track)"/>
  <xacro:property name="wheelbase" value="$(arg wheelbase)"/>

  <!-- Placeholder sizes, used only when a mesh is not supplied. -->
  <xacro:property name="wheel_width" value="0.085"/>
  <xacro:property name="body_length" value="0.512"/>
  <xacro:property name="body_width" value="0.610"/>
  <xacro:property name="body_height" value="0.189"/>

  <xacro:arg name="body_mesh" default="package://mdrobot_description/meshes/body.stl"/>
  <xacro:arg name="wheel_mesh" default="package://mdrobot_description/meshes/wheel.stl"/>
  <!-- Mecanum wheels are chiral and only one hand was exported, so the left
       pair uses a reflection of it: mesh_simplify with its mirror option on z, which flips the
       roller hand and reverses the winding so the surface still faces out. A
       negative <mesh scale> would reflect the geometry and leave the winding,
       and the wheel would render inside out. -->
  <xacro:arg name="wheel_mesh_left"
             default="package://mdrobot_description/meshes/wheel_mirror.stl"/>
  <xacro:arg name="mesh_scale" default="0.001 0.001 0.001"/>
  <!-- Rotation about ROS z applied AFTER standing the CAD frame up. See the
       note above: settled by driving the machine, not by reading the files. -->
  <xacro:arg name="body_yaw_deg" default="270"/>
  <xacro:arg name="wheel_yaw_deg" default="0"/>
  <xacro:property name="body_yaw" value="${radians($(arg body_yaw_deg))}"/>
  <xacro:property name="wheel_yaw" value="${radians($(arg wheel_yaw_deg))}"/>
  <xacro:property name="body_mesh" value="$(arg body_mesh)"/>
  <xacro:property name="wheel_mesh" value="$(arg wheel_mesh)"/>
  <xacro:property name="wheel_mesh_left" value="$(arg wheel_mesh_left)"/>

  <!-- Assembly-coordinate offsets, in metres, from mesh_check. -->
  <xacro:property name="body_cx" value="0.256714"/>
  <xacro:property name="body_cz" value="0.305300"/>
  <xacro:property name="ground_y" value="0.009787"/>
  <xacro:property name="wheel_cx" value="0.074291"/>
  <xacro:property name="wheel_cy" value="0.074230"/>
  <xacro:property name="wheel_cz" value="0.107614"/>

  <material name="body"><color rgba="0.62 0.64 0.67 1.0"/></material>
  <material name="rubber"><color rgba="0.13 0.13 0.15 1.0"/></material>
  <material name="sensor"><color rgba="0.90 0.55 0.10 1.0"/></material>

  <!-- base_link sits on the GROUND at the centre of the wheel footprint, so
       odom -> base_link puts the machine on the floor rather than buried in it
       or hovering. The IMU's roll and pitch then tip it about the contact
       patch, which is where a real machine pivots. -->
  <link name="base_link">
    <visual>
      <xacro:if value="${body_mesh == ''}">
        <origin xyz="0 0 ${wheel_radius + body_height/2}"/>
        <geometry>
          <box size="${body_length} ${body_width} ${body_height}"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="${body_mesh == ''}">
        <!-- Rz(body_yaw) * Rx(+90) takes CAD (x, y, z) to
             (x cos + z sin, x sin - z cos, y), so the offset that brings the
             bbox centre onto the origin has to be rotated with it. z is
             unaffected by the yaw: it is always CAD y, dropped so the wheels'
             contact point lands on the floor. -->
        <origin rpy="${pi/2} 0 ${body_yaw}"
                xyz="${-(body_cx*cos(body_yaw) + body_cz*sin(body_yaw))}
                     ${-(body_cx*sin(body_yaw) - body_cz*cos(body_yaw))}
                     ${-ground_y}"/>
        <geometry>
          <mesh filename="${body_mesh}" scale="$(arg mesh_scale)"/>
        </geometry>
      </xacro:unless>
      <material name="body"/>
    </visual>
  </link>

  <xacro:macro name="wheel" params="name x y mesh">
    <link name="${name}_wheel">
      <visual>
        <xacro:if value="${mesh == ''}">
          <!-- Cylinders are built along z; the axle runs along y. -->
          <origin rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="${mesh == ''}">
          <!-- Same Rx(+90), then the mesh's own bbox centre subtracted so the
               axle sits on the joint. Get this wrong and the wheel orbits.
               The left pair gets the mirrored mesh: which hand goes where is
               the operator's call, made by looking at the machine, not
               something the files could settle. roller_layout is still
               'unknown' in supervisor.yaml, so this is what the wheels LOOK
               like and not a claim about which way the rollers drive. -->
          <origin rpy="${pi/2} 0 ${wheel_yaw}"
                  xyz="${-(wheel_cx*cos(wheel_yaw) + wheel_cz*sin(wheel_yaw))}
                       ${-(wheel_cx*sin(wheel_yaw) - wheel_cz*cos(wheel_yaw))}
                       ${-wheel_cy}"/>
          <geometry>
            <mesh filename="${mesh}" scale="$(arg mesh_scale)"/>
          </geometry>
        </xacro:unless>
        <material name="rubber"/>
      </visual>
    </link>
    <joint name="${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Joint names are the WHEEL_NAMES the whole workspace uses. Rename one and
       robot_state_publisher silently stops turning that wheel. -->
  <xacro:wheel name="front_left"  x="${ wheelbase/2}" y="${ track/2}" mesh="${wheel_mesh_left}"/>
  <xacro:wheel name="front_right" x="${ wheelbase/2}" y="${-track/2}" mesh="${wheel_mesh}"/>
  <xacro:wheel name="rear_left"   x="${-wheelbase/2}" y="${ track/2}" mesh="${wheel_mesh_left}"/>
  <xacro:wheel name="rear_right"  x="${-wheelbase/2}" y="${-track/2}" mesh="${wheel_mesh}"/>

  <!-- Where the HWT901B is bolted. The offset is a GUESS — nothing reads it
       yet, because the heading is used as a change from a reference and a lever
       arm does not affect an angle. It will matter the moment anything
       transforms the acceleration. Measure it then. -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.055 0.037 0.024"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="imu_mount" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${wheel_radius + body_height + 0.012}"/>
  </joint>

</robot>
