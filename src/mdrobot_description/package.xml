<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mdrobot_description</name>
  <version>1.3.0</version>
  <description>
    The machine's URDF, its meshes, and an RViz view of it driven by live
    hardware. It exists because once the machine is under a vehicle nobody can
    see it: the heading and tilt shown here are measured by the IMU and are
    real, the position is dead reckoned from wheels that slip and is not.
  </description>
  <maintainer email="taesuyim.kopo@gmail.com">Taesu Yim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- odometry_node: the pose and the wheel angles this model is driven by -->
  <exec_depend>mdrobot_supervisor</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
