Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /Odometry1
      Splitter Ratio: 0.5
    Width: 340
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: odom
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 15
    # The position here is dead reckoned and drifts. The trail is useful for
    # seeing WHAT the machine thinks it did, not where it actually is.
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /mdrobot_odometry/odom
      Keep: 200
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Covariance:
        Value: false
      Shape:
        Alpha: 0.8
        Color: 255; 170; 0
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.07
        Head Radius: 0.04
        Value: Arrow
  Global Options:
    Background Color: 40; 42; 46
    Fixed Frame: odom
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.5
      Pitch: 0.45
      Yaw: 2.4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: base_link
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
