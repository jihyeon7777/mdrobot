# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# Virtualenvs
.venv/
venv/
env/

# Test / coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ROS 2 colcon output
/build/
/install/
/log/

# C++ build (mdrobot_cpp)
/build/
*.o
*.so

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# ctest output
/Testing/

# Debug images written by mdrobot_plate_ocr. They are frames of your room, they
# churn every run, and they are regenerated by rerunning the probe.
/debug/

# Recordings taken while chasing something: attitude surveys from
# mdrobot_imu's imu_survey, topic echoes captured during a run. Evidence for a
# decision, not source -- the numbers belong in a README or a comment, the
# samples do not belong in git.
*.csv
/run.txt

# Raw CAD exports. The decimated meshes the URDF actually loads live in
# src/mdrobot_description/meshes/; these are the originals they came from
# (19 MB, a million triangles) and are regenerated from CAD, not from here.
/STL/

# Autonomous run recordings. Kept out of git: they are evidence for a
# decision, and the numbers that matter end up in a comment or a README.
/runs/*.jsonl
